{
  "title": "Move Canvas",
  "children": [
    {
      "title": "Preset bank",
      "lines": [
        "Open Preset bank.",
        "Choose a sound map.",
        "For an instrument",
        "choose Programs, a",
        "family and a sound."
      ]
    },
    {
      "title": "Drums on channel 3",
      "lines": [
        "Choose a drum kit.",
        "This selects part 10.",
        "In Part and program",
        "set Keyboard Routing",
        "to Selected part. You",
        "can now play drums on",
        "channel 3."
      ]
    },
    {
      "title": "Multitimbral MIDI",
      "lines": [
        "In Multitimbral mode",
        "each keyboard channel",
        "plays its own part.",
        "Send drums on channel",
        "10."
      ]
    },
    {
      "title": "Edit a control",
      "lines": [
        "Jog to a page and",
        "click. Touch a knob",
        "to hear its value.",
        "Turn to edit. Or jog",
        "to a parameter, click",
        "and turn Jog. Menu",
        "goes back."
      ]
    },
    {
      "title": "Engine in use",
      "lines": [
        "Use one Move Canvas",
        "at a time. Unload the",
        "generator or exit the",
        "player with Shift and",
        "Back. Reopen the one",
        "you want."
      ]
    }
  ]
}
