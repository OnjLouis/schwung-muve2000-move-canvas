{
  "title": "Move Canvas",
  "children": [
    {
      "title": "Preset bank",
      "lines": [
        "Open Preset bank at",
        "the current sound.",
        "Turn Jog to audition.",
        "Click to keep it and",
        "go back. For another",
        "map, open Part and",
        "program, then Sound",
        "Map."
      ]
    },
    {
      "title": "Drums on channel 3",
      "lines": [
        "Choose Drum kits and",
        "turn Jog to a kit.",
        "Selected part routing",
        "plays it on your",
        "pads. Browsing",
        "instruments returns",
        "to the track part."
      ]
    },
    {
      "title": "Multitimbral MIDI",
      "lines": [
        "In Multitimbral mode",
        "each keyboard channel",
        "plays its own part.",
        "Send drums on channel",
        "10."
      ]
    },
    {
      "title": "Edit a control",
      "lines": [
        "Jog to a page and",
        "click. Touch a knob",
        "to hear its value.",
        "Turn to edit. Or jog",
        "to a parameter, click",
        "and turn Jog. Menu",
        "goes back."
      ]
    },
    {
      "title": "Engine in use",
      "lines": [
        "Use one Move Canvas",
        "at a time. Unload the",
        "generator or exit the",
        "player with Shift and",
        "Back. Reopen the one",
        "you want."
      ]
    },
    {
      "title": "Edit part",
      "lines": [
        "Follow track is on by",
        "default. Open Part",
        "and program to choose",
        "a fixed part."
      ]
    },
    {
      "title": "Pad response",
      "lines": [
        "In Part and program,",
        "Pad response starts",
        "on Fast for live",
        "playing. Choose",
        "Buffered if a busy",
        "patch crackles."
      ]
    }
  ]
}
