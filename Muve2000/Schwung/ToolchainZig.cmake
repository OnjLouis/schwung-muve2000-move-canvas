set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG LLVM_BIN)
set(CMAKE_AR "${LLVM_BIN}/llvm-ar.exe" CACHE FILEPATH "")
set(CMAKE_RANLIB "${LLVM_BIN}/llvm-ranlib.exe" CACHE FILEPATH "")
set(CMAKE_C_COMPILER "${ZIG}" cc)
set(CMAKE_CXX_COMPILER "${ZIG}" c++)
set(CMAKE_C_FLAGS_INIT "-target aarch64-linux-gnu.2.34 -mcpu=cortex_a72")
set(CMAKE_CXX_FLAGS_INIT "-target aarch64-linux-gnu.2.34 -mcpu=cortex_a72 -ffp-contract=off")
