{
  "title": "Muve2000",
  "children": [
    {
      "title": "Play a sound",
      "lines": [
        "Choose Instruments,",
        "Drums or SFX Kits.",
        "Turn Jog to hear each",
        "sound as you play.",
        "Click Back to return",
        "to the same category."
      ]
    },
    {
      "title": "Edit a part",
      "lines": [
        "Edit part follows the",
        "track channel. Open",
        "Settings to pin a",
        "part, change bank or",
        "set the octave."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "Volume, pan, cutoff,",
        "resonance, attack,",
        "release, reverb send",
        "and chorus send."
      ]
    },
    {
      "title": "Sound data",
      "lines": [
        "Copy your MU2000",
        "program and four wave",
        "ROMs into the",
        "generator ROM folder.",
        "Keep the dump",
        "subfolder."
      ]
    },
    {
      "title": "Bank Variations",
      "lines": [
        "Choose a program,",
        "then Bank Variations",
        "to browse its other",
        "voices."
      ]
    },
    {
      "title": "Pad response",
      "lines": [
        "In Settings, Pad",
        "response starts on",
        "Fast for live",
        "playing. Choose",
        "Buffered if a busy",
        "patch crackles."
      ]
    }
  ]
}
